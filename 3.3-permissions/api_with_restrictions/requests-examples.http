# примеры API-запросов

@baseUrl = http://localhost:8000/api
@token = 566c7d74078a8fb5e6c0761b9d4a988ded0693f1

# получение объявлений (без авторизации; черновики скрыты)
GET {{baseUrl}}/advertisements/
Content-Type: application/json

###

# создание объявления
POST {{baseUrl}}/advertisements/
Content-Type: application/json
Authorization: Token {{token}}

{
  "title": "Шкаф IKEA",
  "description": "Срочно"
}

###

# попытка поменять объявление
PATCH {{baseUrl}}/advertisements/1/
Content-Type: application/json
Authorization: Token {{token}}

{
  "status": "CLOSED"
}

###

# фильтрация по создателю
GET {{baseUrl}}/advertisements/?creator=2
Content-Type: application/json

###

# фильтрация по статусу
GET {{baseUrl}}/advertisements/?status=OPEN
Content-Type: application/json

###

# фильтрация по дате (DateFromToRangeFilter)
GET {{baseUrl}}/advertisements/?created_at_after=2020-01-01&created_at_before=2030-01-01
Content-Type: application/json

###

# дополнительно: добавить в избранное
POST {{baseUrl}}/advertisements/2/favorite/
Content-Type: application/json
Authorization: Token {{token}}

###

# дополнительно: фильтрация по избранным объявлениям
GET {{baseUrl}}/advertisements/?favorite=true
Content-Type: application/json
Authorization: Token {{token}}

###

# дополнительно: убрать из избранного
DELETE {{baseUrl}}/advertisements/2/favorite/
Content-Type: application/json
Authorization: Token {{token}}

###

# дополнительно: черновик виден только автору
GET {{baseUrl}}/advertisements/3/
Content-Type: application/json
Authorization: Token {{token}}
