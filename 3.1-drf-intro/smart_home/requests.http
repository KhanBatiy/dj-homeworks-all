# примеры API-запросов

@baseUrl = http://localhost:8000/api

# получение датчиков
GET {{baseUrl}}/sensors/
Content-Type: application/json

###

# создание датчика
POST {{baseUrl}}/sensors/
Content-Type: application/json

{
  "name": "ESP32",
  "description": "Датчик на кухне за холодильником"
}

###

# обновление датчика
PATCH {{baseUrl}}/sensors/1/
Content-Type: application/json

{
  "description": "Перенес датчик на балкон"
}

###

# добавление измерения
POST {{baseUrl}}/measurements/
Content-Type: application/json

{
  "sensor": 1,
  "temperature": 22.3
}

###

# добавление измерения с картинкой (multipart, поле picture опционально)
POST {{baseUrl}}/measurements/
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="sensor"

1
--WebAppBoundary
Content-Disposition: form-data; name="temperature"

22.3
--WebAppBoundary
Content-Disposition: form-data; name="picture"; filename="flower.jpg"
Content-Type: image/jpeg

< ./flower.jpg
--WebAppBoundary--

###

# получение информации по датчику
GET {{baseUrl}}/sensors/1/
Content-Type: application/json
